{
  "name": "newxsagent",
  "private": true,
  "scripts": {
    "dev:api": "uvicorn xsagent.api.app:create_app --factory --reload --host 0.0.0.0 --port 8000",
    "dev:web": "pnpm --filter @xsagent/web dev",
    "build:web": "pnpm --filter @xsagent/web build",
    "test:api": "pytest",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@playwright/test": "^1.61.0"
  }
}
